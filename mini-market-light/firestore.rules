rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'diezzminecraft@gmail.com';
    }

    // Mahsulotlar: hamma ko'radi, faqat admin o'zgartiradi
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Telefon raqamlar: bitta raqam faqat bitta akkauntga tegishli bo'ladi.
    // Hujjat nomi = raqam (9 ta son). Boshqaning raqamini olib bo'lmaydi.
    match /phones/{phone} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && phone.matches('[0-9]{9}')
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Foydalanuvchi profili: faqat o'zi (yoki admin) ko'radi, faqat o'zi yozadi.
    // Telefon raqam phones/{raqam} da shu foydalanuvchiga biriktirilgan bo'lishi shart.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'first', 'last', 'phone', 'email', 'at', 'updatedAt', 'cart', 'favs', 'pickup'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() == 9
        && getAfter(/databases/$(database)/documents/phones/$(request.resource.data.phone)).data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Buyurtmalar: xaridor faqat o'zi uchun yaratadi, admin hammasini ko'radi va holatini o'zgartiradi
    match /orders/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
